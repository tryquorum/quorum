# /Users/jun/Developer/quorum/.env.local 예시. 실제 파일은 커밋하지 않아요(.gitignore: .env*).
# launchd(infra/launchd/com.tryquorum.server.plist)가 이 파일을 읽고, bun 도 작업 폴더의 .env.local 을 자동으로 읽어요.

# 리스너
QUORUM_PORT=4317                      # 로컬 전용(이 맥 안에서 온 요청만)
QUORUM_PUBLIC_PORT=4318               # 공개 전용(터널 뒤). 빈 값이면 열지 않아요
PUBLIC_ORIGIN=https://quorum.lidgeai.com

# Cloudflare Access (둘 다 있어야 공개 리스너가 열려요)
ACCESS_TEAM=lidgeai
ACCESS_AUD=                           # 통합 스레드가 Access 앱을 만든 뒤 채워요
ALLOWED_EMAILS=jun@lidgeai.com        # 쉼표로 여러 명

# 선택
QUORUM_LOCAL_USER=jun@lidgeai.com     # 로컬 리스너 /api/me 에 보일 이메일
QUORUM_BOARD_WRITE=0                  # 1 이면 방향판에 결과·승인 대기를 올려요
QUORUM_MCP_PROPOSE=0                  # 1 이면 MCP 로 의회를 열 수 있어요(aside exec 는 유료)
